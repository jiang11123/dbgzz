# Local backend and desktop artifacts; never commit build output.
build/depth-runtime/*.zip
backend/cmd/server/server
backend/server
backend/desktop
backend/cmd/desktop/build/
backend/cmd/desktop/build/bin/
backend/cmd/desktop/frontend/wailsjs/
!backend/cmd/desktop/frontend/dist/
backend/cmd/desktop/frontend/dist/*
!backend/cmd/desktop/frontend/dist/.gitkeep
# One-off local probe scripts and their compiled output.
backend/tmp_*
# Screenshot/video audit workspaces and reliability fixtures are generated by
# local verification scripts and must not become part of an open-source patch.
web/.libtv-*
web/test/.agent-reliability-*/
# Scratch trees built by tests that materialize a rewritten module graph; a run
# killed mid-flight must not leave them inside a patch.
web/test/.local-workspace-stale-*/
web/test/.timeline-persist-http-*/
web/package.json.md5
web/.playwright/
# Generated screenshot, probe, and browser-audit workspaces.
/.libtv-canvas-*/
web/.*audit*
web/.round-*
web/.smoke-*
web/.probe-*
web/.gated-*
web/.path*/
web/.selected*/
web/.threshold*/
web/.count-*/
web/.dense-*/
web/.directional-*/
web/.director-*/
web/.final-*/
web/.oneendpoint-*/
web/.panfix-*/
web/.reference-*/
web/.canvas-probe-*/
plugin-packages/*.beeftv-plugin

# Python bytecode generated by the local depth-capture helper.
tools/depth-capture/**/__pycache__/
*.py[cod]
