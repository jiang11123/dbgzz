{
  "name": "doubao-video-workspace",
  "version": "3.0.0",
  "private": true,
  "description": "豆奶画布：本地 AI 创作画布与豆包多账号工作站",
  "author": "jiang11123",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer-tests": "node scripts/build-renderer-tests.mjs",
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package:win": "npm run build:beeftv && npm run build && electron-builder --win --x64 --publish never",
    "build:beeftv": "node scripts/build-beeftv.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "test": "npm run build:main && npm run build:renderer-tests && node --test \"dist/main/main/**/*.test.js\" \"dist/main/renderer-tests/**/*.test.js\"",
    "build:icons": "electron scripts/build-icons.cjs",
    "local": "node scripts/run-local.mjs",
    "local:restart": "node scripts/run-local.mjs --restart",
    "local:full": "node scripts/run-local.mjs --full"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "chokidar": "^4.0.3",
    "electron-updater": "6.8.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
